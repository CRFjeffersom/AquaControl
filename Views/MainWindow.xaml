<Window x:Class="WatercoolerTemp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:controls="clr-namespace:WatercoolerTemp.Controls"
        Title="Aqua 240X"
        Width="340"
        Height="360"
        MinWidth="340"
        MinHeight="360"
        MaxWidth="340"
        MaxHeight="360"
        WindowStyle="None"
        ResizeMode="NoResize"
        AllowsTransparency="True"
        Background="Transparent"
        Foreground="#E9F2F0"
        FontFamily="{StaticResource DisplayFont}"
        WindowStartupLocation="CenterScreen"
        Closed="WindowClosed">
    <Border Background="#0B0E0F" BorderBrush="#26302F" BorderThickness="1" CornerRadius="12" Padding="18">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="28" />
                <RowDefinition Height="*" />
                <RowDefinition Height="48" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Grid Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="DragWindow">
                <TextBlock Text="AQUA 240X" FontSize="11" FontWeight="SemiBold" VerticalAlignment="Center" Foreground="#9AA8A5" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="−" Click="MinimizeWindow" Style="{StaticResource WindowButton}" />
                    <Button Content="×" Click="CloseWindow" Style="{StaticResource WindowButton}" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="1" Margin="0,10,0,0">
                <controls:TemperatureRing Progress="{Binding Progress}" IndicatorBrush="{Binding IndicatorBrush}" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="CPU TEMP" FontSize="10" HorizontalAlignment="Center" Foreground="#778582" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="0,4,0,0">
                        <TextBlock Text="{Binding TemperatureText}" FontSize="46" FontWeight="SemiBold" Foreground="{Binding IndicatorBrush}" />
                        <TextBlock Text="°C" FontSize="13" Margin="5,24,0,0" Foreground="{Binding IndicatorBrush}" />
                    </StackPanel>
                </StackPanel>
            </Grid>

            <Grid Grid.Row="2" Margin="4,0,4,0">
                <StackPanel VerticalAlignment="Center">
                    <TextBlock Text="DEVICE" FontSize="9" Foreground="#63716E" />
                    <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                        <Ellipse Width="7" Height="7" Fill="{Binding StatusBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Status}" FontSize="11" Margin="7,0,0,0" />
                    </StackPanel>
                </StackPanel>
                <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                    <TextBlock Text="PORT" FontSize="9" Foreground="#63716E" HorizontalAlignment="Right" />
                    <TextBlock Text="COM3" FontSize="11" Margin="0,3,0,0" HorizontalAlignment="Right" />
                </StackPanel>
            </Grid>

            <Grid Grid.Row="3">
                <Button Content="{Binding ConnectionActionText}" Command="{Binding ConnectionCommand}" Style="{StaticResource ActionButton}" HorizontalAlignment="Center" />
            </Grid>

            <TextBlock Grid.Row="3" Text="{Binding Message}" FontSize="8" Foreground="#5F706C" VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,-16" />
        </Grid>
    </Border>
</Window>